{
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/Rahul/.local/bin/graphify.EXE hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/Rahul/.local/bin/graphify.EXE hook-guard read"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f graphify-out/graph.json ] && [ ! -f graphify-out/.update-lock ]; then touch graphify-out/.update-lock; graphify update . >graphify-out/.update-last.log 2>&1; rm -f graphify-out/.update-lock; fi; true",
            "async": true,
            "statusMessage": "Refreshing knowledge graph (code-only, no LLM)..."
          }
        ]
      }
    ]
  }
}