# Copy this file to .env and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# scripts/bug.mjs only (never VITE_-prefixed -- must never reach the
# browser bundle). Lets the CLI mirror bugs into the same table the
# deployed Bug Ledger UI reads. Settings -> API -> "service_role secret".
# Omit this to keep the CLI fully local/offline (bugs/bugs.json only).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Optional: Cloudflare Turnstile anti-bot protection site key
# VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key
