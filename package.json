{
  "name": "trip-tracker-2026",
  "private": true,
  "version": "1.101.4",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/install-git-hooks.mjs && node scripts/sync-maplibre-worker.mjs",
    "predev": "node scripts/sync-maplibre-worker.mjs",
    "dev": "vite --host",
    "prebuild": "node scripts/sync-maplibre-worker.mjs",
    "build": "tsc -b && vite build && node scripts/stampServiceWorker.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "generate:assets": "capacitor-assets generate --android --ios",
    "bug": "node scripts/bug.mjs",
    "bug:add": "node scripts/bug.mjs add",
    "bug:list": "node scripts/bug.mjs list",
    "bug:resolve": "node scripts/bug.mjs resolve",
    "bug:sync": "node scripts/bug.mjs sync",
    "feature": "node scripts/feature.mjs",
    "feature:add": "node scripts/feature.mjs add",
    "feature:list": "node scripts/feature.mjs list",
    "feature:ship": "node scripts/feature.mjs ship",
    "feature:sync": "node scripts/feature.mjs sync"
  },
  "dependencies": {
    "@capacitor/android": "8.2.0",
    "@capacitor/app": "8.1.1",
    "@capacitor/browser": "8.0.4",
    "@capacitor/camera": "8.2.2",
    "@capacitor/cli": "8.2.0",
    "@capacitor/core": "8.2.0",
    "@capacitor/geolocation": "8.2.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "8.2.0",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/push-notifications": "8.1.2",
    "@capacitor/status-bar": "^8.0.3",
    "@capgo/capacitor-updater": "^8.51.13",
    "@supabase/supabase-js": "^2.112.2",
    "autoskills": "^0.3.6",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.31.0",
    "maplibre-gl": "^6.4.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "pg": "^8.23.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
